{
  "name": "paic-public-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run prepare-bundle && tsc -b && vite build",
    "lint": "eslint src --max-warnings=0",
    "test": "npm run prepare-bundle && vitest run",
    "test:browser": "playwright test",
    "format:check": "prettier --check src e2e scripts package.json eslint.config.js index.html tsconfig.json vite.config.ts playwright.config.ts",
    "preview": "vite preview",
    "prepare-bundle": "node scripts/prepare-bundle.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.15.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "axe-core": "^4.13.0",
    "eslint": "10.8.0",
    "jsdom": "30.0.1",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
